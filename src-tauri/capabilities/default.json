{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Nexus Chronicle default capability set",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-open",
    "fs:scope-appdata-recursive",
    "fs:scope-download-recursive",
    "fs:scope-document-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open"
  ]
}

